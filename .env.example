# Brevo (Sendinblue) SMTP API credentials for the contact form
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Contact form recipient
CONTACT_RECEIVER=info@expertpower.com.sa

# Base URL of the contact API in /backend (used by src/lib/api-client.ts).
# Leave empty to call the same origin (the Next.js /api/contact route).
NEXT_PUBLIC_API_URL=
