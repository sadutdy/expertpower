# ============================================
# Expert Power Contact API — Environment Config
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Server
PORT=3001
NODE_ENV=production

# CORS — comma-separated list of allowed frontend origins
# Use the domain(s) where your Next.js static site is hosted
ALLOWED_ORIGINS=https://expertpower.com.sa,https://www.expertpower.com.sa

# SMTP Credentials — use an app-specific password, NOT your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-app-specific-password

# Email Receiver — where all enquiries are sent
CONTACT_RECEIVER=info@expertpower.com.sa

# Optional: CAPTCHA Secret Key (Cloudflare Turnstile or reCAPTCHA)
# Leave empty to disable CAPTCHA verification
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
